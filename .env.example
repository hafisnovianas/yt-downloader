# ==============================================================================
# PANDUAN PENGATURAN VARIABLE & SECRET (CLOUDFLARE DASHBOARD)
# ==============================================================================
# Karena kamu menghubungkan repositori GitHub langsung dari dashboard Cloudflare
# (Workers & Pages Git Integration):
#
# 1. PENGUJIAN LOKAL (wrangler dev):
#    Salin berkas '.dev.vars.example' menjadi '.dev.vars' di folder proyek:
#    ACCESS_PIN=123456
#
# 2. DI CLOUDFLARE DASHBOARD (PRODUCTION):
#    - Buka: Cloudflare Dashboard -> Workers & Pages -> Pilih Worker kamu
#    - Buka tab: Settings -> Variables and Secrets
#    - Di bagian "Environment Variables" / "Secrets", klik "Add":
#        Type : Secret (Encrypted)
#        Name : ACCESS_PIN
#        Value: [PIN rahasia kamu, contoh: 889900]
#    - Klik "Deploy" / "Save"
# ==============================================================================

ACCESS_PIN=your_secret_pin_here
