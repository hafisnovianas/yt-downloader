# ==============================================================================
# YT DOWNLOADER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Lokal (Wrangler Dev):
#    Salin berkas ini menjadi '.dev.vars' untuk pengujian di komputer lokal:
#    cp .env.example .dev.vars
#
# 2. Production (Cloudflare Dashboard):
#    Tambahkan variabel di bawah pada:
#    Cloudflare Dashboard ➔ Workers & Pages ➔ [Pilih Worker] ➔ Settings ➔ Variables and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KEAMANAN & KONTROL AKSES (SECURITY)
# ------------------------------------------------------------------------------
# PIN rahasia untuk membatasi akses unduhan dari publik.
# - Terisi   : Pengguna wajib memasukkan PIN ini sebelum bisa mengambil info & mengunduh.
# - Kosong   : Aplikasi terbuka untuk siapa saja tanpa proteksi.
# Rekomendasi: Kombinasi angka/huruf 6-12 karakter (contoh: 889900).
ACCESS_PIN=your_secret_pin_here

# ------------------------------------------------------------------------------
# 2. LINGKUNGAN APLIKASI (ENVIRONMENT)
# ------------------------------------------------------------------------------
# Mode lingkungan aplikasi: 'development' | 'production'
ENVIRONMENT=production
